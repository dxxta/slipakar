DATABASE_URL=postgresql://slipakar:password@localhost:5432/slipakar
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
S3_ENDPOINT=localhost
S3_PORT=3900
S3_USE_SSL=false
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-s3-secret-key
S3_BUCKET=slipakar
S3_REGION=garage
S3_PATH_STYLE=true
REDIS_URL=redis://localhost:6379
ADMIN_EMAILS=admin@example.com
RABBITMQ_URL=amqp://guest:guest@localhost:5672
METRICS_TOKEN=replace-with-a-random-token-of-at-least-16-characters

# ==========================================
# Docker compose
# ==========================================
COMPOSE_PROJECT_NAME=slipakar
POSTGRES_USER=slipakar
POSTGRES_DB=slipakar
POSTGRES_PASSWORD=change-me-postgres-password
RABBITMQ_USER=slipakar
RABBITMQ_PASSWORD=change-me-rabbitmq-password
# S3 credentials for Garage (access key format: GK + 24 hex characters, secret key: 64 hex characters)
# Generate with: echo GK$(openssl rand -hex 12)
S3_ACCESS_KEY=GK0123456789abcdef01234567
# Generate with: openssl rand -hex 32
S3_SECRET_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
# Internal cluster RPC secret for Garage (generate with: openssl rand -hex 32)
GARAGE_RPC_SECRET=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
# Admin API bearer token for Garage bootstrap (generate with: openssl rand -hex 24)
GARAGE_ADMIN_TOKEN=00112233445566778899aabbccddeeff0011223344556677
# 32-byte hex key for AES-256-GCM encryption (generate with: openssl rand -hex 32)
APP_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
BETTER_AUTH_SECRET=change-me-better-auth-secret
BETTER_AUTH_URL=http://localhost:8080
# Public origin accepted by Better Auth for browser requests; user and admin apps share this origin.
TRUSTED_ORIGINS=http://localhost:8080
# Third-party bearer API: environment master switch stays off unless explicitly enabled.
API_ACCESS_ENABLED=false
# Comma-separated absolute browser origins allowed to use bearer keys; empty blocks browser CORS.
API_ALLOWED_ORIGINS=
# Comma-separated parent origins permitted to frame the Slipakar app (HTTPS only, except localhost for development).
# Empty disables embedding. Requires API access env/runtime switches and the Admin Setup Embedding runtime switch.
EMBED_ALLOWED_ORIGINS=
GOOGLE_CLIENT_ID=change-me-google-client-id
GOOGLE_CLIENT_SECRET=change-me-google-client-secret
# Admin emails (comma-separated, optional)
ADMIN_EMAILS=admin@example.com
# Bearer token for scraping Prometheus metrics (minimum 16 characters)
METRICS_TOKEN=change-me-metrics-token-min-16-chars
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
# Uptime Kuma admin credentials for docker-compose.status.yml and, optionally, the API Setup connection test.
UPTIME_KUMA_ADMIN_USER=admin
UPTIME_KUMA_ADMIN_PASSWORD=change-me-uptime-kuma-password
# Disable the startup demo workspace by setting this to false.
SEED_DEMO_PROJECT=true
# Optional Grafana API token used by the admin Setup connection test.
SETUP_GRAFANA_API_TOKEN=
# Host binding address (defaults to 127.0.0.1 for local isolation)
BIND_ADDRESS=127.0.0.1
# Host ports for the API and Grafana (change when a port is taken, e.g. Dokploy uses 3000).
API_PORT=3000
GRAFANA_PORT=3001
# Published web host port (optional; user app is / and admin app is /console/).
WEB_PORT=8080
# Internal API address used by the Nginx web service.
API_UPSTREAM=api:3000
# Optional Sentry DSNs embedded into production web bundles at image build time.
SENTRY_DSN_USER=
SENTRY_DSN_ADMIN=

# Optional public Slipakar landing site: start it with `docker compose --profile landing up -d`.
# Bind to loopback when placing a TLS reverse proxy in front.
LANDING_BIND_ADDRESS=127.0.0.1
LANDING_PORT=8082
# Public URLs embedded into server-rendered links and SEO metadata at request time.
LANDING_APP_URL=http://localhost:8080
LANDING_SITE_URL=http://localhost:8082
LANDING_REPO_URL=http://localhost:8082/#open-source
LANDING_DOCS_URL=http://localhost:8082/#self-host

# ==========================================
# Standalone status page (docker-compose.status.yml)
# ==========================================
STATUS_PAGE_SLUG=status
STATUS_PAGE_TITLE=Slipakar status
STATUS_PORT=8081
STATUS_BIND_ADDRESS=127.0.0.1
KUMA_ADMIN_PORT=3002
KUMA_ADMIN_BIND_ADDRESS=127.0.0.1
# Public URLs monitored by the standalone status stack; empty values skip those monitors.
KUMA_MONITOR_WEB_URL=
KUMA_MONITOR_ADMIN_URL=
KUMA_MONITOR_API_URL=
KUMA_MONITOR_LANDING_URL=
KUMA_MONITOR_LANDING=false
# Optional private Kuma admin URL reachable by the API for the Admin Setup connection test.
SETUP_UPTIME_URL=

# ==========================================
# Platform Auth SMTP (Optional: enables user email changes with verification and broadcast emails)
# ==========================================
# Note: Database-stored Mail integration settings configured in Admin Setup (/admin/setup) take precedence over these env vars.
# Docker Compose passes unset optional variables as empty strings, which the API treats as unset.
# Credential login needs platform SMTP (AUTH_SMTP_* or Admin Setup Mail); without it, only Google login works.
# When neither DB mail nor AUTH_SMTP_* is configured, POST /api/auth/change-email returns 400 EMAIL_CHANGE_UNAVAILABLE.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_SECURE=false
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_MAIL_FROM=
# Optional frontend URL for verification link redirect (defaults to first TRUSTED_ORIGINS entry).
# When set, failed Google sign-in without its own error page lands on <APP_URL>/auth/error.
APP_URL=

# ==========================================
# Login Activity & Trust Proxy
# ==========================================
# Number of days to retain LoginEvent records before purging (default: 90, 1..3650)
LOGIN_EVENT_RETENTION_DAYS=90
# Trust proxy configuration for Express: false (default bare API), hop count (e.g. 1 behind single nginx proxy), or comma-separated CIDRs
TRUST_PROXY=1
