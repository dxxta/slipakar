# Port of the Angular development server.
PORT=4302
# Runtime URLs are read by `make dev` and the production Express SSR server, then emitted into HTML without a window global.
LANDING_APP_URL=http://localhost:8080
LANDING_SITE_URL=http://localhost:8082
LANDING_REPO_URL=http://localhost:8082/#open-source
LANDING_DOCS_URL=http://localhost:8082/#self-host
# Local development only; leave unset in production.
# LANDING_ADMIN_URL=http://localhost:4301
