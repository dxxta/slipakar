# Environment for running the API by itself on the host (make dev). Copy to .env with `make env`.
# The defaults match the local infrastructure in docker-compose.yml (make infra-up).
# All values are throwaway local-development constants except the Google credentials.
DATABASE_URL=postgresql://lokaslip:lokaslip_dev@localhost:5433/lokaslip
REDIS_URL=redis://localhost:6380
RABBITMQ_URL=amqp://lokaslip:lokaslip_dev@localhost:5673
S3_ENDPOINT=localhost
S3_PORT=3910
S3_USE_SSL=false
S3_ACCESS_KEY=GK0123456789abcdef01234567
S3_SECRET_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
S3_BUCKET=lokaslip
S3_REGION=garage
S3_PATH_STYLE=true
APP_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
BETTER_AUTH_SECRET=dev-only-better-auth-secret-0123456789abcdef
# Public URL of the auth endpoints as the browser sees them: the user-web dev server, which proxies /api to this API.
# Register http://localhost:4300/api/auth/callback/google as an authorized redirect URI in your Google OAuth client.
BETTER_AUTH_URL=http://localhost:4300
TRUSTED_ORIGINS=http://localhost:4300,http://localhost:4301
APP_URL=http://localhost:4300
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
ADMIN_EMAILS=admin@example.com
METRICS_TOKEN=dev-metrics-token-0123456789
PORT=3000
TRUST_PROXY=false
# Optional platform mail (profile email change, broadcasts); leave empty to keep them disabled.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_SECURE=false
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_MAIL_FROM=
