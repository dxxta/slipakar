# Environment for running the API by itself on the host (make dev). Copy to .env with `make env`.
# The defaults match the local infrastructure in docker-compose.yml (make infra-up).
# All values are throwaway local-development constants except the Google credentials.
DATABASE_URL=postgresql://slipakar:slipakar_dev@localhost:5433/slipakar
REDIS_URL=redis://localhost:6380
RABBITMQ_URL=amqp://slipakar:slipakar_dev@localhost:5673
S3_ENDPOINT=localhost
S3_PORT=3910
S3_USE_SSL=false
S3_ACCESS_KEY=GK0123456789abcdef01234567
S3_SECRET_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
S3_BUCKET=slipakar
S3_REGION=garage
S3_PATH_STYLE=true
APP_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
BETTER_AUTH_SECRET=dev-only-better-auth-secret-0123456789abcdef
# Public URL of the auth endpoints as the browser sees them: the user-web dev server, which proxies /api to this API.
# Register http://localhost:4300/api/auth/callback/google as an authorized redirect URI in your Google OAuth client.
BETTER_AUTH_URL=http://localhost:4300
TRUSTED_ORIGINS=http://localhost:4300,http://localhost:4301
APP_URL=http://localhost:4300
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
ADMIN_EMAILS=admin@example.com
METRICS_TOKEN=dev-metrics-token-0123456789
PORT=3000
TRUST_PROXY=false
# Optional platform mail (profile email change, broadcasts); leave empty to keep them disabled.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_SECURE=false
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_MAIL_FROM=

# Demo workspace is seeded once on API startup; set false to disable.
SEED_DEMO_PROJECT=true
# Local development monitoring integrations (start with `make dev-monitoring-up`).
SETUP_GRAFANA_URL=http://localhost:3011
SETUP_GRAFANA_API_TOKEN=

# ==========================================
# Standalone status page (root docker-compose.status.yml)
# ==========================================
# Uptime Kuma credentials are used by the standalone stack and optionally by the API Setup test.
UPTIME_KUMA_ADMIN_USER=admin
UPTIME_KUMA_ADMIN_PASSWORD=slipakar_dev_admin
# The local monitoring profile uses localhost:3012; for a standalone deployment set the private Kuma admin URL reachable by this API.
SETUP_UPTIME_URL=http://localhost:3012
SETUP_UPTIME_USERNAME=admin
SETUP_UPTIME_PASSWORD=slipakar_dev_admin
STATUS_PAGE_SLUG=status
STATUS_PAGE_TITLE=Slipakar status
STATUS_PORT=8081
STATUS_BIND_ADDRESS=127.0.0.1
KUMA_ADMIN_PORT=3002
KUMA_ADMIN_BIND_ADDRESS=127.0.0.1
# Public URLs monitored by the standalone status stack; empty values skip those monitors.
KUMA_MONITOR_WEB_URL=
KUMA_MONITOR_ADMIN_URL=
KUMA_MONITOR_API_URL=
KUMA_MONITOR_LANDING_URL=
KUMA_MONITOR_LANDING=false
