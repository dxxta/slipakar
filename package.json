{
  "name": "slipakar",
  "private": true,
  "version": "3.1.3",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @slipakar/api",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "dev:admin": "npm run start -w @slipakar/admin-web",
    "test:admin": "npm run test -w @slipakar/admin-web ",
    "dev:user": "npm run start -w @slipakar/user-web",
    "test:user": "npm run test -w @slipakar/user-web",
    "e2e": "playwright test",
    "release": "commit-and-tag-version",
    "release:patch": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "commit-and-tag-version": "^13.3.0"
  },
  "overrides": {
    "prisma": "7.10.1"
  }
}
