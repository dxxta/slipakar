{
  "name": "lokaslip",
  "private": true,
  "version": "1.10.0",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @lokaslip/api",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "dev:admin": "npm run start -w @lokaslip/admin-web",
    "test:admin": "npm run test -w @lokaslip/admin-web ",
    "dev:user": "npm run start -w @lokaslip/user-web",
    "test:user": "npm run test -w @lokaslip/user-web",
    "e2e": "playwright test",
    "release": "commit-and-tag-version"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "commit-and-tag-version": "^13.3.0"
  },
  "overrides": {
    "prisma": "7.10.1"
  }
}
